{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "production": {
      "environment": "production",
      "node": "24.21.0",
      "env": {
        "EAS_NO_FROZEN_LOCKFILE": "1",
        "EAS_BUILD_DISABLE_NPM_CACHE": "1"
      },
      "android": {
        "image": "latest",
        "buildType": "app-bundle"
      }
    },
    "production-apk": {
      "extends": "production",
      "android": {
        "buildType": "apk"
      }
    }
  }
}
