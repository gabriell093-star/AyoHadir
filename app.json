{
  "expo": {
    "name": "AyoHadir",
    "slug": "ayohadir",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "ayohadir",
    "android": {
      "package": "com.ayohadir.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      }
